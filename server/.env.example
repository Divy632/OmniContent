# ---- Server ----
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
# Public base URL of this API (used to build image URLs for local storage)
PUBLIC_URL=http://localhost:5000

# ---- Database & Auth ----
MONGO_URI=mongodb://127.0.0.1:27017/content_platform
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d

# ---- AI providers ----
# TEXT_PROVIDER: mock | anthropic | openai      (mock works with no key — good for demos)
# IMAGE_PROVIDER: mock | openai | pollinations  (pollinations needs no key)
TEXT_PROVIDER=mock
IMAGE_PROVIDER=mock
AI_API_KEY=
TEXT_MODEL=claude-sonnet-5-5
# Only needed if the image provider is OpenAI and differs from the text key
IMAGE_API_KEY=
IMAGE_MODEL=gpt-image-1

# ---- Cost control ----
# Max AI generations per user per hour (generate + regenerate)
GENERATION_LIMIT_PER_HOUR=15

# ---- Image storage ----
# Leave Cloudinary blank to store files locally in server/uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
